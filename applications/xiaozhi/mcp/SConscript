from building import *

cwd = GetCurrentDir()
src = Glob('*.c')
# Kitchen Panel mode: skip all C++ sources (mcp_server etc.)
if not GetDepend(['BSP_USING_KITCHEN_PANEL']):
    src += Glob('*.cpp')
CPPPATH = [cwd]

group = DefineGroup('xiaozhi_mcp', src, depend = [''], CPPPATH = CPPPATH)

Return('group')
